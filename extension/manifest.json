{
  "manifest_version": 3,
  "name": "VoiceStudio - Audio & Voice Recorder",
  "version": "1.0.0",
  "description": "Single-page audio recording studio for capturing, playing, and managing voice notes and Actions on Google SSML clips.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Open VoiceStudio Recorder",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  }
}
